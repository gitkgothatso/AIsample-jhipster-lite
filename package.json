{
  "name": "a-i-sample-app",
  "version": "0.0.0",
  "private": true,
  "description": "JHipster Sample Application",
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm-run-all build:*",
    "build:ng": "ng build",
    "dev": "npm-run-all --parallel dev:*",
    "dev:ng": "ng serve",
    "e2e": "cypress open --e2e --config-file src/test/webapp/e2e/cypress-config.ts",
    "e2e:headless": "cypress run --headless --config-file src/test/webapp/e2e/cypress-config.ts",
    "lint": "eslint .",
    "ng": "ng",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "prettier:format": "prettier --write .",
    "start": "ng serve",
    "test": "npm run watch:test",
    "test:component": "start-server-and-test dev http://localhost:9000 'cypress open --e2e --config-file src/test/webapp/component/cypress-config.ts'",
    "test:component:headless": "start-server-and-test dev http://localhost:9000 'cypress run --headless --config-file src/test/webapp/component/cypress-config.ts'",
    "test:coverage": "ng test --coverage",
    "watch": "npm-run-all --parallel watch:*",
    "watch:ng": "ng build --watch --configuration development",
    "watch:test": "ng test --watch"
  },
  "dependencies": {
    "@angular/animations": "19.2.10",
    "@angular/cdk": "19.2.15",
    "@angular/common": "19.2.10",
    "@angular/compiler": "19.2.10",
    "@angular/core": "19.2.10",
    "@angular/forms": "19.2.10",
    "@angular/material": "19.2.15",
    "@angular/platform-browser": "19.2.10",
    "@angular/platform-browser-dynamic": "19.2.10",
    "@angular/router": "19.2.10",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "19.0.1",
    "@angular/build": "19.2.11",
    "@angular/cli": "19.2.11",
    "@angular/compiler-cli": "19.2.10",
    "@prettier/plugin-xml": "3.4.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.17",
    "@typescript-eslint/eslint-plugin": "8.32.0",
    "@typescript-eslint/parser": "8.32.0",
    "angular-eslint": "19.4.0",
    "cypress": "14.3.3",
    "eslint": "9.26.0",
    "eslint-plugin-cypress": "4.3.0",
    "globals": "16.1.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-preset-angular": "14.5.5",
    "jest-sonar-reporter": "2.0.0",
    "lint-staged": "15.5.2",
    "npm-run-all2": "8.0.1",
    "prettier": "3.5.3",
    "prettier-plugin-gherkin": "3.1.2",
    "prettier-plugin-java": "2.6.7",
    "prettier-plugin-organize-imports": "4.1.0",
    "prettier-plugin-packagejson": "2.5.12",
    "start-server-and-test": "2.0.11",
    "ts-jest": "29.3.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.0"
  },
  "engines": {
    "node": ">=22"
  },
  "jestSonar": {
    "reportPath": "target/test-results",
    "reportFile": "TESTS-results-sonar.xml"
  }
}
